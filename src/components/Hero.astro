---
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { formatYear, t, type Lang } from '../i18n/ui';
import studio from '../assets/hero/amireyzed-studio.png';

interface Props {
  lang: Lang;
  firstYear: number;
}

const { lang, firstYear } = Astro.props;
const kick = site.socials.find((s) => s.id === 'kick');
const youtube = site.socials.find((s) => s.id === 'youtube');

/* Amir at his desk, cut out of the green screen. One file serves all three layers below. */
const art = await getImage({ src: studio, widths: [480, 760, 1000, 1226], format: 'webp', quality: 80 });
const artSizes = '(max-width: 28rem) 28rem, (max-width: 46rem) 100vw, 46rem';
const artImg = {
  src: art.src,
  srcset: art.srcSet.attribute,
  sizes: artSizes,
  width: studio.width,
  height: studio.height,
  alt: '',
  decoding: 'async' as const,
};
---

<section class="hero">
  <div class="portrait" data-portrait aria-hidden="true">
    <img class="portrait-img portrait-dim" {...artImg} loading="eager" fetchpriority="high" />
    <img class="portrait-img portrait-neon" {...artImg} />
    <img class="portrait-img portrait-lit" {...artImg} />
    <span class="portrait-halo"></span>
  </div>
  <div class="sign-wrap">
    <h1 class="sign" data-neon>{site.name[lang]}</h1>
  </div>
  <p class="tagline">{site.tagline[lang]}</p>
  <p class="intro">{site.intro[lang]}</p>
  <ul class="channels">
    {
      kick && (
        <li>
          <a class="chip chip-kick" href={kick.url} target="_blank" rel="me noopener noreferrer">
            {t(lang, 'hero.kick')}
          </a>
        </li>
      )
    }
    {
      youtube && (
        <li>
          <a class="chip" href={youtube.url} target="_blank" rel="me noopener noreferrer">
            {t(lang, 'hero.youtube')}
          </a>
        </li>
      )
    }
  </ul>
  <p class="range">{t(lang, 'hero.range', { from: formatYear(firstYear, lang) })}</p>

  <a class="cue" href="#timeline" data-jump>
    <span>{t(lang, 'hero.scroll')}</span>
    <span class="cue-wire" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(0.75rem, 3vh, 2rem) var(--gutter) 0;
    text-align: center;
    isolation: isolate;
  }

  /* ---------- The portrait: faded at the top of the page, lit where the cursor points ----------
     A dim, desaturated picture sits under the name. A full-colour copy shows only inside a soft
     circle at --px/--py (app.ts): the cursor on desktop, his face or the last tap on touch screens.
     The neon banana on the wall stays on and flickers on with the sign. */
  .portrait {
    --pw: clamp(28rem, calc(100% + var(--gutter) * 2), 46rem);
    position: relative;
    z-index: -1;
    flex: none;
    width: var(--pw);
    aspect-ratio: 1226 / 624;
    margin-block-end: calc(var(--pw) * -0.13);
    pointer-events: none;
    user-select: none;
    -webkit-mask-image: radial-gradient(ellipse 60% 64% at 50% 38%, #000 50%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 64% at 50% 38%, #000 50%, transparent 100%);
  }

  .portrait-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .portrait-dim {
    opacity: 0.2;
    filter: saturate(0.35) brightness(0.85);
  }

  .portrait-neon {
    -webkit-mask-image: radial-gradient(ellipse 9.5% 23% at 86.9% 52%, #000 62%, transparent 100%);
    mask-image: radial-gradient(ellipse 9.5% 23% at 86.9% 52%, #000 62%, transparent 100%);
    animation: neon-on 1.5s steps(1, end) 0.15s both;
  }

  .portrait-halo {
    position: absolute;
    top: 52%;
    left: 86.9%;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 238 160 / 0.3), rgb(226 229 101 / 0.1) 40%, transparent 70%);
    transform: translate(-50%, -50%);
    mix-blend-mode: screen;
    animation: neon-on 1.5s steps(1, end) 0.15s both;
  }

  .portrait-lit {
    --pr: clamp(6.5rem, 15vw, 11rem);
    -webkit-mask-image: radial-gradient(
      circle var(--pr) at var(--px, 50.2%) var(--py, 40%),
      #000 0%,
      rgb(0 0 0 / 0.55) 42%,
      transparent 100%
    );
    mask-image: radial-gradient(
      circle var(--pr) at var(--px, 50.2%) var(--py, 40%),
      #000 0%,
      rgb(0 0 0 / 0.55) 42%,
      transparent 100%
    );
  }

  .sign-wrap {
    max-width: 100%;
    perspective: 900px;
  }

  /* The neon sign: warm-white tube with a lime halo. --neon (0..1) is driven by the cursor distance. */
  .sign {
    --n: var(--neon, 0.7);
    font-family: var(--font-display);
    font-size: var(--step-hero);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fffdf2;
    text-shadow:
      0 0 calc(1px + 3px * var(--n)) rgb(255 253 242 / 0.95),
      0 0 calc(6px + 12px * var(--n)) rgb(244 237 153 / 0.75),
      0 0 calc(16px + 34px * var(--n)) rgb(226 229 101 / 0.5),
      0 0 calc(40px + 90px * var(--n)) rgb(147 148 88 / 0.45);
    transform: rotateX(var(--srx, 0deg)) rotateY(var(--sry, 0deg));
    transition: transform 250ms linear;
    animation: neon-on 1.5s steps(1, end) 0.15s both;
  }

  html[lang='fa'] .sign {
    font-weight: 900;
    letter-spacing: 0;
  }

  /* The one autonomous moment on the page: the sign flickers on, like the neon in the studio. */
  @keyframes neon-on {
    0% {
      opacity: 0.08;
    }
    8% {
      opacity: 1;
    }
    11% {
      opacity: 0.25;
    }
    18% {
      opacity: 1;
    }
    21% {
      opacity: 0.45;
    }
    25%,
    100% {
      opacity: 1;
    }
  }

  .tagline {
    margin-block-start: 1.1rem;
    color: var(--lemon);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .intro {
    max-width: 34rem;
    margin-block-start: 1.6rem;
    color: var(--fg-muted);
    text-wrap: pretty;
  }

  /* Two quiet doors to where Amir is active now; the timeline stays the main road. */
  .channels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 1.4rem;
  }

  .chip-kick {
    border-color: rgb(83 252 24 / 0.55);
    color: var(--kick);
  }

  .chip-kick:hover {
    border-color: var(--kick);
    background: rgb(83 252 24 / 0.1);
    box-shadow: 0 0 24px -8px rgb(83 252 24 / 0.6);
  }

  .range {
    margin-block-start: 0.8rem;
    color: var(--fg-muted);
    font-size: var(--step--1);
  }

  .cue {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    margin-block-start: 3rem;
    color: var(--fg-muted);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .cue:hover {
    color: var(--lime);
  }

  /* Continues straight into the timeline axis below. */
  .cue-wire {
    width: 2px;
    height: clamp(3rem, 9vh, 5.5rem);
    background: linear-gradient(to bottom, transparent, var(--line));
  }

  @media (max-width: 59.99rem) {
    .cue-wire {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sign,
    .portrait-neon,
    .portrait-halo {
      animation: none;
      transition: none;
    }
  }
</style>
